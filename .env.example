# =============================================================================
# Copy to backend/.env and fill in your values:
#   cp .env.example backend/.env
# =============================================================================

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=180s
SERVER_IDLE_TIMEOUT=60s
SERVER_MAX_REQUEST_BYTES=1048576
TRUST_PROXY=false

# --- URLs ---
AUTH_BASE_URL=http://localhost:8080
API_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# --- Database (start with: docker compose up -d) ---
DATABASE_URL=postgres://realput:realput@localhost:5432/realput?sslmode=disable
DB_MIGRATE_ON_START=true
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m

# --- AI provider: groq (recommended), gemini, or openai ---
AI_PROVIDER=groq
AI_REQUEST_TIMEOUT=180s

# Groq — free tier + web search (https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_RESULTS_MODEL=groq/compound-mini

# Gemini — Google Search grounding (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI — fallback (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your_openai_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_RESULTS_MODEL=gpt-4o
OPENAI_WEB_SEARCH=true

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URL=http://localhost:3000/api/auth/callback/google

# --- Auth & sessions ---
SESSION_COOKIE_NAME=realput_session
SESSION_TTL=168h
SESSION_UPDATE_AGE=24h
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
BCRYPT_COST=12

# --- CORS & rate limiting ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization,Cookie
CORS_MAX_AGE=12h
RATE_LIMIT_RPS=30
RATE_LIMIT_BURST=60

# --- Frontend (used by Next.js dev proxy) ---
API_URL=http://127.0.0.1:8080
